(version 1)
(rule "JLCPCB: smallest hole"
	(constraint hole_size (min 0.3mm)))
(rule "JLCPCB: via diameter"
	(constraint via_diameter (min 0.4mm))
	(condition "A.Type == 'Via'"))
(rule "JLCPCB: via annular ring"
	(constraint annular_width (min 0.05mm))
	(condition "A.Type == 'Via'"))
(rule "JLCPCB: plated hole annular ring"
	(constraint annular_width (min 0.25mm))
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'"))
(rule "JLCPCB: hole to hole"
	(constraint hole_to_hole (min 0.2mm)))
(rule "JLCPCB: pad hole to pad hole"
	(constraint hole_to_hole (min 0.45mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad'"))
(rule "JLCPCB: plated hole to track"
	(constraint hole_clearance (min 0.35mm))
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Track'"))
(rule "JLCPCB: copper to board edge"
	(constraint edge_clearance (min 0.2mm)))
(rule "JLCPCB: silkscreen text height"
	(constraint text_height (min 1mm))
	(condition "A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS'"))
(rule "JLCPCB: silkscreen text thickness"
	(constraint text_thickness (min 0.15mm))
	(condition "A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS'"))
